# AICTE Smart Approval Platform - Environment Configuration Example
APP_ENV=development
APP_NAME="AICTE Smart Approval Platform"
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL for production/docker, SQLite fallback for lightweight local test/dev)
DATABASE_URL=sqlite:///./aicte_platform.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicte_approval

# Redis (for caching, rate-limiting, and Celery tasks)
REDIS_URL=redis://localhost:6379/0

# Security (Argon2id + JWT)
SECRET_KEY=dev_secret_key_change_in_production_aicte_sih_2026_super_secure_random
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Document Storage (Local or S3-compatible)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx

# Email Notifications
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@aicte-smartapproval.gov.in
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

LOG_LEVEL=INFO
